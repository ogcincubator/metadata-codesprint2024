</td></tr><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">OWS</p></td><td valign="top"><p class="MsoNormal"><a name="_17d9eace-4fa5-b1e2-8307-8e54a6fae23f" id="_17d9eace-4fa5-b1e2-8307-8e54a6fae23f"></a>OGC Web Services</p>
</td></tr><tr><td valign="top" align="left"><p align="left" style="margin-left:0pt;text-align:left;" class="MsoNormal">PROV</p></td><td valign="top"><p class="MsoNormal"><a name="_0843c9cc-af0b-fec5-1fa0-6a5d7267e915" id="_0843c9cc-af0b-fec5-1fa0-6a5d7267e915"></a>Provenance family of documents</p>
